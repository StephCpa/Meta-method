{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity record v0.4",
  "type": "object",
  "required": ["id","stage","problem_situation"],
  "properties": {"id":{"type":"string","minLength":1},"stage":{"enum":["exploring","specified","audited","paused","withdrawn"]},"problem_situation":{"type":"string","minLength":1},"prior_limit":{"type":"string","minLength":1},"concrete_transformation":{"type":"string","minLength":1},"expected_added_result":{"type":"string","minLength":1},"first_artifact":{"type":"string","minLength":1},"source_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"move_cards":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"claim_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"parent_candidate_id":{"type":"string","minLength":1},"is_combination":{"type":"boolean"},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"combination_lift":{"type":"object","required":["nearest_simple_combination","relation_changed","added_result","evidence_needed","status"],"properties":{"nearest_simple_combination":{"type":"string","minLength":1},"relation_changed":{"type":"string","minLength":1},"added_result":{"type":"string","minLength":1},"evidence_needed":{"type":"string","minLength":1},"status":{"enum":["proposed","not_established","supported"]},"external_lift_labels":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}}},
  "allOf": [
    {"if":{"properties":{"stage":{"enum":["specified","audited"]}}},"then":{"required":["prior_limit","concrete_transformation","expected_added_result","first_artifact"]}},
    {"if":{"properties":{"stage":{"enum":["specified","audited"]},"is_combination":{"const":true}},"required":["is_combination"]},"then":{"required":["combination_lift"]}},
    {"if":{"properties":{"stage":{"const":"audited"}}},"then":{"required":["claim_refs"],"properties":{"claim_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}}}}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta-method v0.3 claim record",
  "description": "结构契约，不是科学正确性判定器。draft可先使用Markdown轻量卡。",
  "type": "object",
  "required": [
    "id",
    "title",
    "claim_text",
    "contribution_types",
    "object_and_scope",
    "reference_kind",
    "success_criteria",
    "evidence_plan",
    "inapplicable_requirements",
    "codings",
    "source_ids",
    "dataset_role",
    "work_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "contribution_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "theory",
          "explanation",
          "algorithm",
          "system",
          "data_evaluation",
          "decision"
        ]
      }
    },
    "object_and_scope": {
      "type": "string",
      "minLength": 1
    },
    "reference_kind": {
      "enum": [
        "truth",
        "norm",
        "preference",
        "proxy",
        "mixed",
        "not_applicable"
      ]
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "method",
          "suffices_for",
          "status"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "suffices_for": {
            "enum": [
              "next_decision",
              "final_claim"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "available",
              "checked",
              "disputed"
            ]
          }
        }
      }
    },
    "inapplicable_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "reason"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "codings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "role",
          "anchor",
          "rationale"
        ],
        "properties": {
          "code": {
            "enum": [
              "M1",
              "M2",
              "M3",
              "M4",
              "M5",
              "M6",
              "M7",
              "M8",
              "M9",
              "M10",
              "M11",
              "M12",
              "M13",
              "M14"
            ]
          },
          "role": {
            "enum": [
              "author",
              "review",
              "proposal"
            ]
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dataset_role": {
      "enum": [
        "development",
        "holdout",
        "operational"
      ]
    },
    "work_status": {
      "enum": [
        "exploring",
        "planned",
        "active",
        "complete",
        "paused",
        "stopped",
        "rewritten"
      ]
    },
    "completion_basis": {
      "type": "string",
      "minLength": 1
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection_history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "work_status": {
            "const": "complete"
          }
        },
        "required": [
          "work_status"
        ]
      },
      "then": {
        "required": [
          "completion_basis"
        ]
      }
    }
  ]
}

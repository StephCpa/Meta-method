{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta-method v0.3.1 claim record",
  "description": "Authoritative structural schema. Optional traceability fields stay optional for drafts; semantic review is separate.",
  "type": "object",
  "required": [
    "id",
    "title",
    "claim_text",
    "contribution_types",
    "object_and_scope",
    "reference_kind",
    "success_criteria",
    "evidence_plan",
    "inapplicable_requirements",
    "codings",
    "source_ids",
    "dataset_role",
    "work_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "claim_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contribution_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "theory",
          "explanation",
          "algorithm",
          "system",
          "data_evaluation",
          "decision"
        ]
      }
    },
    "object_and_scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reference_kind": {
      "enum": [
        "truth",
        "norm",
        "preference",
        "proxy",
        "mixed",
        "not_applicable"
      ]
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "method",
          "suffices_for",
          "status"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "suffices_for": {
            "enum": [
              "next_decision",
              "final_claim"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "available",
              "checked",
              "disputed"
            ]
          }
        }
      }
    },
    "inapplicable_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "reason"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "codings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "role",
          "anchor",
          "rationale"
        ],
        "properties": {
          "code": {
            "enum": [
              "M1",
              "M2",
              "M3",
              "M4",
              "M5",
              "M6",
              "M7",
              "M8",
              "M9",
              "M10",
              "M11",
              "M12",
              "M13",
              "M14"
            ]
          },
          "role": {
            "enum": [
              "author",
              "review",
              "proposal"
            ]
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "dataset_role": {
      "enum": [
        "development",
        "holdout_candidate",
        "holdout",
        "operational"
      ]
    },
    "work_status": {
      "enum": [
        "exploring",
        "planned",
        "active",
        "complete",
        "paused",
        "stopped",
        "rewritten"
      ]
    },
    "completion_basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection_history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "record_version": {
      "type": "string",
      "enum": [
        "0.3.0",
        "0.3.1"
      ]
    },
    "claim_status": {
      "enum": [
        "draft",
        "under_review",
        "supported",
        "refuted",
        "inconclusive",
        "withdrawn"
      ]
    },
    "evidence_outcome": {
      "enum": [
        "not_evaluated",
        "supports",
        "refutes",
        "inconclusive",
        "mixed"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generation_method": {
          "enum": [
            "synthetic",
            "observed",
            "mixed",
            "unknown"
          ]
        },
        "visibility": {
          "enum": [
            "private",
            "restricted",
            "public",
            "unknown"
          ]
        },
        "development_use": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "development_history": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "problem_family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "family_overlap": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "analyst_exposure": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "independence_review": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "status"
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verification_action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "planned",
              "available",
              "checked",
              "disputed"
            ]
          },
          "evidence_outcome": {
            "enum": [
              "not_evaluated",
              "supports",
              "refutes",
              "inconclusive",
              "mixed"
            ]
          },
          "suffices_for": {
            "enum": [
              "next_decision",
              "final_claim"
            ]
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "claim_id",
          "source_id",
          "source_version",
          "locator",
          "verification_action",
          "status",
          "evidence_outcome",
          "suffices_for"
        ]
      }
    },
    "decision_branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_outcome": {
            "enum": [
              "not_evaluated",
              "supports",
              "refutes",
              "inconclusive",
              "mixed"
            ]
          },
          "allowed_claim": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "action": {
            "enum": [
              "continue",
              "repair",
              "rewrite",
              "complete",
              "pause",
              "stop",
              "review"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "result",
          "evidence_outcome",
          "allowed_claim",
          "action",
          "reason"
        ]
      }
    },
    "revision_effect": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revision_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "prior_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "affected_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "validity": {
            "enum": [
              "retained",
              "recheck_required",
              "superseded",
              "unassessed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "revision_id",
          "prior_version",
          "affected_evidence_ids",
          "validity",
          "reason"
        ]
      }
    },
    "measurement_recheck": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_triggered",
            "triggered_pending",
            "revalidated",
            "inconclusive"
          ]
        },
        "trigger_uses": {
          "type": "array",
          "items": {
            "enum": [
              "training_objective",
              "sample_selection",
              "routing",
              "stopping"
            ]
          },
          "uniqueItems": true
        },
        "changes_to_distinguish": {
          "type": "array",
          "items": {
            "enum": [
              "target_property",
              "sample_distribution",
              "representation_or_instrument",
              "label_definition"
            ]
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "trigger_uses",
        "description"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "work_status": {
            "const": "complete"
          }
        },
        "required": [
          "work_status"
        ]
      },
      "then": {
        "required": [
          "completion_basis"
        ]
      }
    }
  ]
}
